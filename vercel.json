{
  "installCommand": "npm install --prefix career-ai",
  "buildCommand": "npm --prefix career-ai run build",
  "outputDirectory": "career-ai/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}